#!/bin/sh

# Set default value for APP_BASE_DIR if not already set
APP_BASE_DIR=${APP_BASE_DIR:-/var/www/html}

# Check if the console file exists
if [ ! -f "$APP_BASE_DIR/bin/console" ]; then
    echo "Error: Symfony console file not found in $APP_BASE_DIR/bin/"
    echo "Please ensure APP_BASE_DIR is set correctly, Symfony is installed and the console file is in the expected location."
    exit 1
fi

# Run the PHP console command with all provided arguments
php "$APP_BASE_DIR/bin/console" "$@"
